# Nom du projet Compose (préfixe des conteneurs, du réseau et du volume)
COMPOSE_PROJECT_NAME=demo-api

# Identifiants PostgreSQL (non sensibles)
POSTGRES_USER=demo
POSTGRES_DB=demo

# Ports publiés sur l'hôte
API_PORT=8080
ADMINER_PORT=8081

# Fichier contenant le mot de passe de la base.
# Il est monté comme secret Docker et ne doit jamais être commité.
DB_PASSWORD_FILE=./secrets/db_password.txt
